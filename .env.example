# Exemple de configuration locale.
# Copier ce fichier vers .env avant le premier lancement :
# cp .env.example .env

# Backend FastAPI
# Adresse d'ecoute du backend dans le conteneur.
BACKEND_HOST=0.0.0.0

# Port expose sur la machine hote pour acceder a l'API.
BACKEND_PORT=8000

# Prefixe commun des routes metier de l'API.
API_PREFIX=/api/v1

# Frontend
# Port expose sur la machine hote pour acceder a l'interface React.
FRONTEND_PORT=5173

# URL publique du backend appelee par le frontend.
VITE_API_URL=http://localhost:8000

# Prefixe API utilise par les clients HTTP du frontend.
VITE_API_PREFIX=/api/v1

# Base de donnees PostgreSQL
# Attention : le code utilise actuellement le nom POSTGRES_ADRESS.
# Dans Docker Compose, la valeur doit rester postgres, qui est le nom du service.
POSTGRES_ADRESS=postgres
POSTGRES_DB=prisoners-dilemma
POSTGRES_USER=bastienbogoss
POSTGRES_PASSWORD=bastienbogoss

# Docker Compose
# Prefixe utilise pour nommer le projet, les reseaux et les volumes Docker.
COMPOSE_PROJECT_NAME=dilemme_prisonnier
